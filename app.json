{
  "expo": {
    "name": "Moose",
    "slug": "moose-mobile",
    "version": "0.8.0",
    "scheme": "moose",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.verysmallwoods.moose",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.verysmallwoods.moose",
      "versionCode": 20
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      "./plugins/termux-network.cjs",
      "expo-sharing",
      "./plugins/termux-setup.cjs",
      "./plugins/notification-intent.cjs",
      [
        "expo-image-picker",
        {
          "photosPermission": "Select photos to attach to a conversation.",
          "cameraPermission": "Take a photo to attach to a conversation.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
