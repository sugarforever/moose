{
  "name": "moose-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "npm run bundle:runtime && expo start --dev-client",
    "android": "npm run bundle:runtime && expo run:android",
    "ios": "npm run bundle:runtime && expo run:ios",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "export": "npm run bundle:runtime && expo export --platform ios --platform android",
    "smoke:portable": "npm run bundle:runtime && node scripts/smoke-portable.mjs",
    "verify": "npm run bundle:runtime && npm test && npm run typecheck && npm run smoke:portable && npm run export"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@expo/vector-icons": "^15.0.2",
    "expo": "58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-font": "58.0.9",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "pi-durable-expo-env": "file:vendor/pi-durable-expo-env-0.1.0.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "esbuild": "^0.27.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }
}
